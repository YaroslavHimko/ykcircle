# Public website domain, without protocol or a trailing slash.
# Change this during a rebrand/domain migration.
VITE_SITE_DOMAIN=ykcircle.com

# Optional: use a dedicated API origin instead of https://api.<VITE_SITE_DOMAIN>.
# VITE_API_URL=https://api.ykcircle.com

# API_URL is also accepted during the frontend build. VITE_API_URL takes precedence.
# Staging example (set in the FRONTEND build environment, then rebuild):
# VITE_SITE_DOMAIN=staging.ykcircle.com
# API_URL=https://staging-api.ykcircle.com
# Backend environment changes cannot update an already built frontend.
